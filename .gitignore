# AI assistants
#
# NOTE: `.omc/*` and not `.omc/`. Git cannot re-include a path inside an
# EXCLUDED DIRECTORY, so the `!.omc/skills/` negation below is a silent no-op
# when the parent is ignored as a directory. Excluding the directory's
# *contents* keeps the negation working.
.claude/settings.local.json
.claude/*.local.json
.claude/**/*.log
CLAUDE.local.md
.omc/*
!.omc/skills/
.omx/
.omo/
.codex/
AGENTS.override.md
.aider.input.history
.aider.chat.history.md
.aider.llm.history
.aider.tags.cache.v*
.gemini/
gemini-debug.log
.gemini-clipboard/
.cursor/
.continue/
.codeium/
.windsurf/
.copilot/
.opencode/
.cline/
.crush/
.warp/

# Editors
.idea/
.vscode/
.history/
*.swp
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
Session.vim
Sessionx.vim
.netrwhist
tags
[._]*.un~

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
*.icloud

